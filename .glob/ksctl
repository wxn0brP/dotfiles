#!/bin/zsh

# ksctl - simple systemctl wrapper

HELP="Operations: s=status, r=restart, e=enable, d=disable, t=stop, x=start, l=logs, ll=logs cmd"

if [[ $# -lt 2 ]]; then
  echo "Usage: ksctl <unit> <operation>"
  echo "$HELP"
  exit 1
fi

UNIT=$1
OP=$2

case $OP in
  s) sudo systemctl status $UNIT ;;
  r) sudo systemctl restart $UNIT ;;
  e) sudo systemctl enable $UNIT ;;
  d) sudo systemctl disable $UNIT ;;
  t) sudo systemctl stop $UNIT ;;
  x) sudo systemctl start $UNIT ;;
  l) journalctl -f -u $UNIT ;;
  ll) echo "journalctl -f -u $UNIT" ;;
  *)
    echo "Unknown operation: $OP"
    echo "$HELP"
    exit 1
    ;;
esac
