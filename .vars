alias cd..="cd .."
alias ll="ls -al"
alias cls="clear"
c() {
    vscodium "$(pwd)"
}
alias ce="c && exit"
alias py="python"
alias g="./girl.sh"
alias cg="chmod +x ./girl.sh"
alias ng="nano ./girl.sh"
alias p="cd ~/Desktop"
alias code="vscodium"
alias ex=exit
alias exot=exit
alias exut=exit
alias ipc="ip -br addr"
alias dots-up="$HOME/dotfiles/update.sh"
alias nit="nitl"

alias ndts="node --input-type=module < "
alias op="opencode"
alias brt="bun run src/test.ts"
alias bri="bun run src/index.ts"
alias ttc="tsc && tsc-alias"

alias uuu="paru -Syu --noconfirm --skipreview"
export SUDO_EDITOR=kwrite
export VISUAL=micro
export EDITOR=micro

export PATH=$PATH:~/.glob:~/dotfiles/glob:~/dotfiles/glob-path:~/.ing:~/.bun/bin:~/.npm-global/bin:~/.local/bin:~/.zhiva/bin

source ~/dotfiles/glob/create_json

lock() {
	local sid
	sid=$(loginctl show-seat seat0 -p ActiveSession --value)
	[ -n "$sid" ] || { echo "lock: no active session on seat0" >&2; return 1; }
	loginctl lock-session "$sid"
}
