#!/bin/zsh

# ksctl - simple systemctl & journalctl wrapper

HELP="Usage: ksctl [-u|--user] <unit> <operation> [args...]

Flags:
  -u, --user    operate on the current user's services (systemctl/journalctl --user)

Operations:
  s=status  r=restart  e=enable  d=disable  t=stop  x=start
  l=logs (args passed to journalctl, default -f)
  g=grep <pattern> (filter logs)
  c=command (print the journalctl command instead of running it)"

usage() {
  echo "$HELP"
  exit 1
}

USER_MODE=false
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --) shift; POSITIONAL+=("$@"); break ;;
    -u|--user) USER_MODE=true; shift ;;
    -h|--help) echo "$HELP"; exit 0 ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

if [[ ${#POSITIONAL[@]} -lt 2 ]]; then
  usage
fi

if $USER_MODE; then
  SCTL=(systemctl --user)
  JCTL=(journalctl --user)
else
  SCTL=(sudo systemctl)
  JCTL=(journalctl)
fi

set -- "${POSITIONAL[@]}"
UNIT=$1
shift
OP=$1
shift
EXTRA=("$@")

case $OP in
  s) "${SCTL[@]}" status "$UNIT" ;;
  r) "${SCTL[@]}" restart "$UNIT" ;;
  e) "${SCTL[@]}" enable "$UNIT" ;;
  d) "${SCTL[@]}" disable "$UNIT" ;;
  t) "${SCTL[@]}" stop "$UNIT" ;;
  x) "${SCTL[@]}" start "$UNIT" ;;
  l)
    if [[ ${#EXTRA[@]} -eq 0 ]]; then
      "${JCTL[@]}" -u "$UNIT" -f
    else
      "${JCTL[@]}" -u "$UNIT" "${EXTRA[@]}"
    fi
    ;;
  g)
    if [[ ${#EXTRA[@]} -eq 0 ]]; then
      echo "grep requires a pattern" >&2
      usage
    fi
    "${JCTL[@]}" -u "$UNIT" | grep -- "${EXTRA[@]}"
    ;;
  c|ll)
    echo "${JCTL[*]} -u $UNIT ${EXTRA[*]}"
    ;;
  *)
    echo "Unknown operation: $OP" >&2
    usage
    ;;
esac
